{
  "name": "praxis",
  "private": true,
  "version": "1.0.0",
  "description": "PRAXIS — Autonomous Workforce Simulation & Behavioral Telemetry Platform",
  "homepage": "https://praxis-iota-puce.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/DvivekD/Praxis.IO.git"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "postinstall": "pnpm --filter @praxis/web exec prisma generate",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "latest",
    "prettier": "latest",
    "prisma": "^5.22.0",
    "@prisma/client": "^5.22.0"
  },
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  },
  "type": "module"
}
